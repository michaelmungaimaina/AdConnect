# ============================================================
# AdConnect — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Public-facing URL (include trailing slash)
APP_API_URL=https://adconnect.co.ke/

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://adconnect.co.ke,http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adconnect_db
DB_USER=adconnect_user
DB_PASSWORD=your_strong_database_password_here

# Connection pool
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=mail.adconnect.co.ke
SMTP_PORT=465
SMTP_SECURE=true

# The email account used as sender
EMAIL_USER=info@adconnect.co.ke
EMAIL_PASS=your_email_password_here

# Admin notification recipient
ADMIN_EMAIL=info@adconnect.co.ke

# From display name
EMAIL_FROM_NAME=AdConnect Team

# ── Google OAuth2 / Calendar ──────────────────────────────────
# These come from Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Redirect URIs (must match Google Console)
GOOGLE_REDIRECT_URI=https://adconnect.co.ke

# Calendar timezone
CALENDAR_TIMEZONE=Africa/Nairobi

# ── Security ──────────────────────────────────────────────────
# JWT secret for session tokens (generate with: openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=8h

# Session secret
SESSION_SECRET=replace_with_another_long_random_string_here

# ── File Uploads ──────────────────────────────────────────────
# Max file size in MB
UPLOAD_MAX_SIZE_MB=50

# Directory (relative to project root)
UPLOAD_DIR=uploads

# Allowed video types (pipe-separated)
ALLOWED_VIDEO_TYPES=video/mp4

# Allowed image types (pipe-separated)
ALLOWED_IMAGE_TYPES=image/png|image/jpeg|image/webp

# ── Analytics / Tracking ──────────────────────────────────────
# Google Analytics Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager container ID
GTM_ID=GTM-XXXXXXX

# Facebook Pixel ID
FACEBOOK_PIXEL_ID=your_pixel_id_here

# ── Rate Limiting ─────────────────────────────────────────────
# Requests per window (per IP)
RATE_LIMIT_MAX=100

# Window in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# ── Admin ─────────────────────────────────────────────────────
# Default SUPER_ADMIN credentials (change immediately after first login)
ADMIN_DEFAULT_EMAIL=admin@adconnect.co.ke
ADMIN_DEFAULT_PASSWORD=ChangeMe@1234

# ── CRM / Automation ──────────────────────────────────────────
# Cron schedule for automated follow-up emails (UTC)
# Default: every day at 8am EAT (5am UTC)
FOLLOWUP_CRON_SCHEDULE=0 5 * * *

# Max follow-up contacts per run
FOLLOWUP_MAX_BATCH=50

# ── Social Media Links ────────────────────────────────────────
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61567259036362
INSTAGRAM_URL=https://www.instagram.com/adconnect_digital/
TIKTOK_URL=https://www.tiktok.com/@adconnect
YOUTUBE_URL=https://www.youtube.com/@adconnect
TWITTER_URL=https://twitter.com/adconnect

# ── Company Info ─────────────────────────────────────────────
COMPANY_NAME=AdConnect
COMPANY_PHONE=+254790064130
COMPANY_EMAIL=info@adconnect.co.ke
COMPANY_LOCATION=Nairobi, Kenya
COMPANY_WEBSITE=https://www.adconnect.co.ke

# ============================================================
# AdConnect — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Public-facing URL (include trailing slash)
#APP_API_URL=https://adconnect.co.ke/
APP_API_URL=http://localhost:3000/
APP_BASE_URL=https://adconnect.co.ke
COMPANY_WEBSITE=https://adconnect.co.ke
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://www.adconnect.co.ke,http://localhost:3000

# ── Security (REQUIRED) ──────────────────────────────────────
# Generate each with:  openssl rand -hex 48
JWT_SECRET=6e530d1ea3b921e7a287ea26a36fbe7d80069bfca5d5578b2939ce23f42be6807319e7166c5f16e1e4c78c5cdcbb45b5adaa732a61d04eb3e46a0f799e7edbf6
JWT_EXPIRES_IN=8h
# Secret for the scheduled campaign URL: /api/campaign/cron?key=CRON_SECRET
CRON_SECRET=

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
#DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adconnect
DB_USER=root
DB_PASSWORD=13579QEtuo....

# Connection pool
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=mail.adconnect.co.ke
SMTP_PORT=465
SMTP_SECURE=true

# The email account used as sender
EMAIL_USER=info@adconnect.co.ke
EMAIL_PASS=K050988misg@

# Admin notification recipient
ADMIN_EMAIL=info@adconnect.co.ke

# From display name
EMAIL_FROM_NAME=AdConnect Team

# ── Google OAuth2 / Calendar ──────────────────────────────────
# These come from Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=404040885025-i6bgvugfmh0199smt6ppoccs2v2avsff.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Redirect URIs (must match Google Console)
GOOGLE_REDIRECT_URI=https://adconnect.co.ke/api/google-oauth/callback

# Calendar timezone
CALENDAR_TIMEZONE=Africa/Nairobi
TZ=Africa/Nairobi

# ── Security ──────────────────────────────────────────────────
# JWT secret for session tokens (generate with: openssl rand -hex 64)
JWT_SECRET=94d5a943b6712e42b32dcd688a36e07052fccab7427ad93a4599d2b3e9eba554
JWT_EXPIRES_IN=8h

# Session secret
SESSION_SECRET=ec1679589d3d8a72cc5d53dc16c9cdead82366f414157be8bec28ccda9d97f10

# ── File Uploads ──────────────────────────────────────────────
# Max file size in MB
UPLOAD_MAX_SIZE_MB=50
PROPOSAL_MAX_MB=15

# Directory (relative to project root)
UPLOAD_DIR=uploads

# Allowed video types (pipe-separated)
ALLOWED_VIDEO_TYPES=video/mp4

# Allowed image types (pipe-separated)
ALLOWED_IMAGE_TYPES=image/png|image/jpeg|image/webp

# ── Analytics / Tracking ──────────────────────────────────────
# Google Analytics Measurement ID
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager container ID
GTM_ID=GTM-XXXXXXX

# Facebook Pixel ID
FACEBOOK_PIXEL_ID=your_pixel_id_here

# ── Rate Limiting ─────────────────────────────────────────────
# Requests per window (per IP)
RATE_LIMIT_MAX=100

# Window in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# ── Admin ─────────────────────────────────────────────────────
# Default SUPER_ADMIN credentials (change immediately after first login)
ADMIN_DEFAULT_EMAIL=admin@adconnect.co.ke
ADMIN_DEFAULT_PASSWORD=ChangeMe@1234

# ── CRM / Automation ──────────────────────────────────────────
# Cron schedule for automated follow-up emails (UTC)
# Default: every day at 8am EAT (5am UTC)
FOLLOWUP_CRON_SCHEDULE=0 5 * * *

# Max follow-up contacts per run
FOLLOWUP_MAX_BATCH=50

# ── Social Media Links ────────────────────────────────────────
FACEBOOK_URL=https://www.facebook.com/profile.php?id=61567259036362
INSTAGRAM_URL=https://www.instagram.com/adconnect_digital/
TIKTOK_URL=https://www.tiktok.com/@adconnect
YOUTUBE_URL=https://www.youtube.com/@adconnect
TWITTER_URL=https://twitter.com/adconnect

# ── Company Info ─────────────────────────────────────────────
COMPANY_NAME=AdConnect
COMPANY_PHONE=+254790064130
COMPANY_EMAIL=info@adconnect.co.ke
COMPANY_LOCATION=Nairobi, Kenya
COMPANY_WEBSITE=https://www.adconnect.co.ke
